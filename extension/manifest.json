{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "2.0.0",
  "description": "Explainable real-time phishing URL detection with an on-device hybrid CNN-BiLSTM model.",
  "permissions": ["storage", "tabs", "webNavigation", "offscreen"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishGuard",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
